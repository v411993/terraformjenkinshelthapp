pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
   /* parameters {
        booleanParam(name: 'DEPLOY_TO_EKS', defaultValue: false, description: 'Set to true to push Docker images to ECR and deploy to EKS.')
        string(name: 'AWS_REGION', defaultValue: 'us-west-2', description: 'AWS region for ECR and EKS.')
        string(name: 'AWS_ACCOUNT_ID', defaultValue: '951897726665', description: 'AWS account id where ECR repositories are created.')
        string(name: 'EKS_CLUSTER', defaultValue: 'aws-dev-cluster', description: 'EKS cluster name.')
        string(name: 'EKS_NAMESPACE', defaultValue: 'bbhealthapp', description: 'Namespace used for deployments.')
        }*/
    environment {
        JAVA_HOME = 'C:/Program Files/Eclipse Adoptium/jdk-21.0.12.101-hotspot'
        MAVEN_HOME = 'C:/Users/q/Tools/apache-maven-3.9.9'
        PATH = "${env.JAVA_HOME}/bin;${env.MAVEN_HOME}/bin;${env.PATH}"
        AWS_REGION = 'us-west-2'
        AWS_ACCOUNT_ID = '951897726665'
        EKS_CLUSTER = 'aws-dev-cluster'
        EKS_NAMESPACE = 'bbhealthapp'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPO = "${ECR_REGISTRY}/aws-dev-app"
        MASTER_IMAGE = "${ECR_REPO}:bbhealthapp-api-master-${IMAGE_TAG}"
        DOCUMENT_IMAGE = "${ECR_REPO}:bbhealthapp-api-document-${IMAGE_TAG}"
        REGISTER_IMAGE = "${ECR_REPO}:bbhealthapp-api-register-${IMAGE_TAG}"
        MASTER_LATEST = "${ECR_REPO}:bbhealthapp-api-master-latest"
        DOCUMENT_LATEST = "${ECR_REPO}:bbhealthapp-api-document-latest"
        REGISTER_LATEST = "${ECR_REPO}:bbhealthapp-api-register-latest"
        MASTER_DIR   = 'application/backend/bbhealthapp-api-master'
        DOCUMENT_DIR = 'application/backend/bbhealthapp-api-document'
        REGISTER_DIR = 'application/backend/bbhealthapp-api-register'
        KUBECONFIG   = "${WORKSPACE}/.kube/config"
        
    }
    stages {
        stage('Checkout and Preflight') {
            steps {
                checkout scm
                bat '''
                    echo Jenkins workspace: %WORKSPACE%
                    java -version
                    mvn -version
                    aws --version
                    docker --version
                    kubectl version --client
                '''
            }
        }
        stage('Build Backend Services in Parallel') {
            parallel {
                stage('Build Master API') {
                    steps {
                        dir('backend/bbhealthapp-api-master') {
                            bat '''
                                set JAVA_HOME=C:/Program Files/Eclipse Adoptium/jdk-21.0.12.101-hotspot
                                set MAVEN_HOME=C:/Users/q/Tools/apache-maven-3.9.9
                                set PATH=%JAVA_HOME%/bin;%MAVEN_HOME%/bin;%PATH%
                                mvn -B clean test package
                                if errorlevel 1 exit /b 1
                            '''
                        }
                    }
                }
                stage('Build Document API') {
                    steps {
                        dir('backend/bbhealthapp-api-document') {
                            bat '''
                                set JAVA_HOME=C:/Program Files/Eclipse Adoptium/jdk-21.0.12.101-hotspot
                                set MAVEN_HOME=C:/Users/q/Tools/apache-maven-3.9.9
                                set PATH=%JAVA_HOME%/bin;%MAVEN_HOME%/bin;%PATH%
                                mvn -B clean test package
                                if errorlevel 1 exit /b 1
                            '''
                        }
                    }
                }
                stage('Build Register API') {
                    steps {
                        dir('backend/bbhealthapp-api-register') {
                            bat '''
                                set JAVA_HOME=C:/Program Files/Eclipse Adoptium/jdk-21.0.12.101-hotspot
                                set MAVEN_HOME=C:/Users/q/Tools/apache-maven-3.9.9
                                set PATH=%JAVA_HOME%/bin;%MAVEN_HOME%/bin;%PATH%
                                mvn -B clean test package
                                if errorlevel 1 exit /b 1
                            '''
                        }
                    }
                }
            }
        }
        stage('Login to ECR') {
           
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials2',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    bat '''
                        echo Logging in to ECR...
                        REM powershell -NoProfile -Command "$p = aws ecr get-login-password --region %AWS_REGION%; echo $p | docker login --username AWS --password-stdin %ECR_REGISTRY%"
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }
        stage('Build and Push Docker Images in Parallel') {
           
            parallel {
                stage('Build Master Image') {
                    steps {
                        dir('backend/bbhealthapp-api-master') {
                            bat '''
                @echo off
                echo Building Master Docker Image from workspace...
                echo Dockerfile path: %WORKSPACE%/backend/bbhealthapp-api-master/Dockerfile
                echo Context path: %WORKSPACE%/backend/bbhealthapp-api-master/target

                docker build -f "%WORKSPACE%/backend/bbhealthapp-api-master/Dockerfile" -t %MASTER_IMAGE% "%WORKSPACE%/backend/bbhealthapp-api-master"

                if errorlevel 1 exit /b 1

                echo Pushing versioned image to ECR...
                docker push %MASTER_IMAGE%

                if errorlevel 1 exit /b 1

                echo Pushing latest image to ECR...
                docker tag %MASTER_IMAGE% %MASTER_LATEST%
                docker push %MASTER_LATEST%

                if errorlevel 1 exit /b 1

                echo Master image pushed successfully to ECR.
            '''
                        }
                    }
                }
                stage('Build Document Image') {
                    steps {
                        dir('backend/bbhealthapp-api-document') {
                          bat '''
                @echo off
                echo Building Document Docker Image from workspace...
                echo Dockerfile path: %WORKSPACE%/backend/bbhealthapp-api-document/Dockerfile
                echo Context path: %WORKSPACE%/backend/bbhealthapp-api-document/target

                docker build -f "%WORKSPACE%/backend/bbhealthapp-api-document/Dockerfile" -t %DOCUMENT_IMAGE% "%WORKSPACE%/backend/bbhealthapp-api-document"

                if errorlevel 1 exit /b 1

                echo Pushing versioned image to ECR...
                docker push %DOCUMENT_IMAGE%

                if errorlevel 1 exit /b 1

                echo Pushing latest image to ECR...
                docker tag %DOCUMENT_IMAGE% %DOCUMENT_LATEST%
                docker push %DOCUMENT_LATEST%

                if errorlevel 1 exit /b 1

                echo Document image pushed successfully to ECR.
            '''
                        }
                    }
                }
                stage('Build Register Image') {
                    steps {
                        dir('backend/bbhealthapp-api-register') {
                             bat '''
                @echo off
                echo Building Register Docker Image from workspace...
                echo Dockerfile path: %WORKSPACE%/backend/bbhealthapp-api-register/Dockerfile
                echo Context path: %WORKSPACE%/backend/bbhealthapp-api-register

                docker build -f "%WORKSPACE%/backend/bbhealthapp-api-register/Dockerfile" -t %REGISTER_IMAGE% "%WORKSPACE%/backend/bbhealthapp-api-register"

                if errorlevel 1 exit /b 1

                echo Pushing versioned image to ECR...
                docker push %REGISTER_IMAGE%

                if errorlevel 1 exit /b 1

                echo Pushing latest image to ECR...
                docker tag %REGISTER_IMAGE% %REGISTER_LATEST%
                docker push %REGISTER_LATEST%

                if errorlevel 1 exit /b 1

                echo Register image pushed successfully to ECR.
            '''
                        }
                    }
                }
            }
        }
        stage('Deploy to EKS') {   
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials2',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    
                    bat '''
                        aws eks update-kubeconfig --region %AWS_REGION% --name %EKS_CLUSTER%
                        kubectl get ns
                        kubectl create namespace %EKS_NAMESPACE% --dry-run=client -o yaml > namespace.yaml
                        kubectl apply -f namespace.yaml
                        kubectl get deploy -n %EKS_NAMESPACE%
                        if errorlevel 1 exit /b 1
                        REM Apply the deployment YAML files
                        
                        @echo off
                        setlocal

                        :: ==========================================
                        :: 1. Document Deployment
                        :: ==========================================
                        kubectl -n %EKS_NAMESPACE% create deployment bbhealthapp-api-document --image="%DOCUMENT_IMAGE%" --dry-run=client -o yaml > document-deploy.yaml
                        if errorlevel 1 exit /b 1
                        kubectl -n %EKS_NAMESPACE% create deployment bbhealthapp-api-document --image="%DOCUMENT_IMAGE%"
                        kubectl -n %EKS_NAMESPACE% set env -f document-deploy.yaml ^
                        rootURL=https://localhost:8002 ^
                        token.secret="%TOKEN_SECRET%" ^
                        file.upload-dir=/app/uploads

                        if errorlevel 1 exit /b 1

                        kubectl -n %EKS_NAMESPACE% apply -f document-deploy.yaml
                        if errorlevel 1 exit /b 1

                        :: ==========================================
                        :: 2. Register Deployment
                        :: ==========================================
                        kubectl -n %EKS_NAMESPACE% create deployment bbhealthapp-api-register --image="%REGISTER_IMAGE%" --dry-run=client -o yaml > register-deploy.yaml
                        if errorlevel 1 exit /b 1
                        kubectl -n %EKS_NAMESPACE% create deployment bbhealthapp-api-register --image="%REGISTER_IMAGE%"
                        kubectl -n %EKS_NAMESPACE% set env -f register-deploy.yaml ^
                        rootURL=https://localhost:8003 ^
                        token.secret="%TOKEN_SECRET%" ^
                        file.upload-dir=/app/uploads

                        if errorlevel 1 exit /b 1

                        kubectl -n %EKS_NAMESPACE% apply -f register-deploy.yaml
                        if errorlevel 1 exit /b 1

                        :: ==========================================
                        :: 3. Master Deployment
                        :: ==========================================
                        kubectl -n %EKS_NAMESPACE% create deployment bbhealthapp-api-master --image="%MASTER_IMAGE%" --dry-run=client -o yaml > master-deploy.yaml
                        if errorlevel 1 exit /b 1
                        kubectl -n %EKS_NAMESPACE% create deployment bbhealthapp-api-master --image="%MASTER_IMAGE%" 
                        kubectl set env -f deployment bbhealthapp-api-master-n %EKS_NAMESPACE%  ^
                        rootURL=https://localhost:8001 ^
                        app.testrun="false" ^
                        token.secret="%TOKEN_SECRET%" ^
                        file.upload-dir=/app/uploads

                        if errorlevel 1 exit /b 1

                        kubectl -n %EKS_NAMESPACE% apply -f master-deploy.yaml
                        if errorlevel 1 exit /b 1

                        echo All three deployment manifests applied successfully.
                        endlocal


                        REM Expose the Services
                        kubectl -n %EKS_NAMESPACE% expose deployment bbhealthapp-api-master --name=bbhealthapp-service-master --port=8001 --target-port=8080 --type=ClusterIP
                        kubectl -n %EKS_NAMESPACE% expose deployment bbhealthapp-api-document --name=bbhealthapp-service-document --port=8002 --target-port=8080 --type=ClusterIP
                        kubectl -n %EKS_NAMESPACE% expose deployment bbhealthapp-api-register --name=bbhealthapp-service-register --port=8003 --target-port=8080 --type=ClusterIP

                        if errorlevel 1 exit /b 1
                        kubectl get deploy -n %EKS_NAMESPACE%
                        kubectl -n %EKS_NAMESPACE% rollout status deployment/bbhealthapp-api-master --timeout=180s
                        kubectl -n %EKS_NAMESPACE% rollout status deployment/bbhealthapp-api-document --timeout=180s
                        kubectl -n %EKS_NAMESPACE% rollout status deployment/bbhealthapp-api-register --timeout=180s
                        timeout /t 180 /nobreak > nul
                        kubectl get deploy -n %EKS_NAMESPACE%
                    '''
                   
                }
            }
        }
    }
    post {
    success {
        echo 'Backend-Jenkins Completed. Triggering Frontend-Jenkins...'
        build job: 'Frontend-Jenkins', wait: false
        }
    }
}