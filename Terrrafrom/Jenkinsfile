pipeline {
    agent any

    environment {
        BASH_PATH = 'C:\\Users\\q\\AppData\\Local\\Microsoft\\WindowsApps\\bash.exe'
        TERRAFORM_DIR = 'Terrrafrom'
        AWS_DEFAULT_REGION = 'us-west-2'
        GIT_REPO_URL = 'https://github.com/v411993/Terraform-jenkins-BBhealthapp.git'
        GIT_BRANCH = 'main'
    }

    stages {
        stage('Checkout Private Repo') {
            steps {
                git branch: 'main', credentialsId: 'bb-healthapp-git', url: 'https://github.com/v411993/terraformjenkinshelthapp.git'
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY',
                     sessionTokenVariable: 'AWS_SESSION_TOKEN']
                ]) {
                    dir("${env.WORKSPACE}\\${env.TERRAFORM_DIR}") {
                        bat "\"${env.BASH_PATH}\" -lc \"terraform init\""
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY',
                     sessionTokenVariable: 'AWS_SESSION_TOKEN']
                ]) {
                    dir("${env.WORKSPACE}\\${env.TERRAFORM_DIR}") {
                        bat "\"${env.BASH_PATH}\" -lc \"terraform validate\""
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY',
                     sessionTokenVariable: 'AWS_SESSION_TOKEN']
                ]) {
                    dir("${env.WORKSPACE}\\${env.TERRAFORM_DIR}") {
                        bat "\"${env.BASH_PATH}\" -lc \"terraform apply -auto-approve\""
                    }
                }
            }
        }
    }
}
