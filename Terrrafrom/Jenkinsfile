pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['apply', 'destroy'],
            description: 'Select Terraform action to run'
        )
    }

    environment {
        TERRAFORM_DIR = 'Terrrafrom'
        AWS_DEFAULT_REGION = 'us-west-2'
        GIT_REPO_URL = 'https://github.com/v411993/Terraform-jenkins-BBhealthapp.git'
        GIT_BRANCH = 'main'
    }

    stages {
        stage('Checkout Private Repo') {
            steps {
                git branch: "${env.GIT_BRANCH}",
                    credentialsId: 'bb-healthapp-git',
                    url: "${env.GIT_REPO_URL}"
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials2',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    dir("${env.WORKSPACE}\\${env.TERRAFORM_DIR}") {
                        bat 'terraform init'
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials2',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    dir("${env.WORKSPACE}\\${env.TERRAFORM_DIR}") {
                        bat 'terraform validate'
                    }
                }
            }
        }

        stage('Delete ECR Images Before Destroy') {
            when {
                expression { params.ACTION == 'destroy' }
            }
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials2',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    bat '''
                        for /f "delims=" %%i in ('aws ecr describe-repositories --query "repositories[].repositoryName" --output text --region %AWS_DEFAULT_REGION% 2^>nul') do (
                            echo Deleting images in repository: %%i
                            for /f "delims=" %%d in ('aws ecr list-images --repository-name %%i --query "imageIds[*].imageDigest" --output text --region %AWS_DEFAULT_REGION% 2^>nul') do (
                                aws ecr batch-delete-image --repository-name %%i --image-ids imageDigest=%%d --region %AWS_DEFAULT_REGION%
                            )
                        )
                    '''
                }
            }
        }

        stage('Terraform Action') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-credentials2',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    dir("${env.WORKSPACE}\\${env.TERRAFORM_DIR}") {
                        script {
                            if (params.ACTION == 'apply') {
                                bat 'terraform apply -auto-approve'
                            } else if (params.ACTION == 'destroy') {
                                bat 'terraform destroy -auto-approve'
                            } else {
                                error "Unsupported Terraform action: ${params.ACTION}"
                            }
                        }
                    }
                }
            }
        }
    }
    post {
    always {
        script {
            if (params.ACTION == 'apply') {
                // This will ONLY run when action is 'apply'
                echo "Running post-actions for apply..."
            } else {
                echo "Skipping post-actions for destroy."
            }
        }
      }
  }
}